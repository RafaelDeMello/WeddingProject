# Copie para .env e preencha. NUNCA commite o .env.
#
# Para desenvolvimento local, troque:
#   NODE_ENV=development
#   PUBLIC_BASE_URL=http://localhost:5173
#   DATA_DIR=../data                       (relativo à pasta server/)
#   DATABASE_URL=file:../../data/db/app.db (relativo a server/prisma/)
#   UPLOAD_OPENS_AT com uma data no passado, para conseguir testar

NODE_ENV=production
PORT=3000
TZ=America/Sao_Paulo
PUBLIC_BASE_URL=https://fotos.example.com
EVENT_SLUG=troque-me
EVENT_NAME=Casamento Rafael & Noiva
UPLOAD_OPENS_AT=2026-10-03T00:00:00-03:00
UPLOAD_CLOSES_AT=2026-10-06T23:59:59-03:00
GUEST_WINDOW_MINUTES=10
GUEST_MAX_PER_WINDOW=10
GUEST_MAX_TOTAL=150
# Limites por IP a cada 10 min: só proteção contra abuso. Dezenas de convidados dividem o IP do
# Wi-Fi do salão; a cota real é por convidado.
IP_MAX_UPLOADS_PER_WINDOW=1000
IP_MAX_GUESTS_PER_WINDOW=150
# Galeria (miniaturas + polling): muitos convidados no mesmo IP geram milhares de requests
IP_MAX_GALLERY_PER_WINDOW=100000
MAX_UPLOAD_BYTES=8388608
MIN_FREE_DISK_MB=2048
# openssl rand -hex 32
SESSION_SECRET=
ADMIN_USER=admin
# openssl rand -base64 24
ADMIN_PASSWORD=
# Login do admin com senha errada, por IP a cada 15 min (padrão 10). Em PRODUÇÃO use 30:
# se alguém da festa errar no mesmo Wi-Fi, o moderador não fica bloqueado (e use dados móveis).
ADMIN_MAX_FAILURES_PER_WINDOW=10
DATA_DIR=/data
DATABASE_URL=file:/data/db/app.db

# Opcional: build do front. Padrão ../web/dist (relativo a server/); na imagem Docker já está no lugar.
# WEB_DIST_DIR=
